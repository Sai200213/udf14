rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Registered user (non-anonymous) for internal employee collections
    function isRegisteredUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── CLOUD-FIRST ARCHITECTURE ──────────────────────────────────────────────
    // isAdmin(), isSuperAdmin(), hasPermission() now read from JWT custom claims.
    // Claims are set by the setAdminClaims Cloud Function on staff login.
    // This means ZERO Firestore lookups per rule evaluation.
    // Staff must call setAdminClaims() once after login + getIdToken(true) to refresh.
    // ─────────────────────────────────────────────────────────────────────────

    // Admin = token has isAdmin:true (set by setAdminClaims Cloud Function)
    function isAdmin() {
      return isRegisteredUser() && request.auth.token.get('isAdmin', false) == true;
    }

    // SuperAdmin = token has isSuperAdmin:true
    function isSuperAdmin() {
      return isRegisteredUser() && request.auth.token.get('isSuperAdmin', false) == true;
    }

    // Permission check — reads from token.permissions array (set by setAdminClaims)
    function hasPermission(permission) {
      return isAuthenticated() && (
        request.auth.token.get('isSuperAdmin', false) == true ||
        (request.auth.token.get('permissions', []).hasAny([permission]))
      );
    }

    // Site visibility — reads sitesManaged from token
    function canStaffViewSite(siteId) {
      return isSuperAdmin() ||
             hasPermission('EMPLOYEES_VIEW_SCOPE_ALL') ||
             hasPermission('SUBMISSIONS_VIEW_SCOPE_ALL') ||
             hasPermission('LEAVES_VIEW_SCOPE_ALL') ||
             hasPermission('ACCOUNT_UPDATES_VIEW_SCOPE_ALL') ||
             hasPermission('RESIGNATIONS_VIEW_SCOPE_ALL') ||
             hasPermission('MANAGE_SITES') ||
             hasPermission('MANAGE_ALL_SITES') ||
             (siteId != null && siteId != '' &&
              request.auth.token.get('sitesManaged', []).hasAny([siteId]));
    }

    // Staff operational permissions for managing employees / submissions
    function canAdminManageEmployees() {
      return isSuperAdmin() ||
             hasPermission('SUBMISSIONS_APPROVE') ||
             hasPermission('EMPLOYEES_MANAGE_DEPLOYMENTS') ||
             hasPermission('EMPLOYEES_MANAGE_CLIENT_IDS') ||
             hasPermission('EMPLOYEES_REQUEST_CORRECTION') ||
             hasPermission('EMPLOYEES_MARK_PROFILE_COMPLETE') ||
             hasPermission('ACCOUNT_UPDATES_APPROVE') ||
             hasPermission('LEAVES_APPROVE') ||
             hasPermission('RESIGNATIONS_APPROVE') ||
             hasPermission('EMPLOYEES_IMPORT');
    }

    function canAdminDeleteEmployees() {
      return isSuperAdmin() ||
             hasPermission('DELETE_EMPLOYEE') ||
             hasPermission('SUBMISSIONS_APPROVE');
    }

    function canAdminCreateEmployees() {
      return isSuperAdmin() ||
             hasPermission('SUBMISSIONS_APPROVE') ||
             hasPermission('EMPLOYEES_IMPORT');
    }

    // Helper to get user's role ID — used only for notification targeting
    // (reads from token first, falls back to Firestore only if token has no roleId)
    function getUserRoleId() {
      return request.auth.token.get('roleId', 'none');
    }

    function isOwnerOfPortalId(portalId) {
      return portalId != null && (
        portalId == request.auth.uid ||
        (request.auth.token.get('employeeId', '') != '' && portalId == request.auth.token.employeeId) ||
        (
          exists(/databases/$(database)/documents/employees/$(portalId)) && (
            get(/databases/$(database)/documents/employees/$(portalId)).data.get('linkedUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/employees/$(portalId)).data.get('uid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/employees/$(portalId)).data.get('ownerUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/employees/$(portalId)).data.get('portalId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/employees/$(portalId)).data.get('employeeId', '') == request.auth.uid
          )
        ) ||
        (
          exists(/databases/$(database)/documents/onboarding_submissions/$(portalId)) && (
            get(/databases/$(database)/documents/onboarding_submissions/$(portalId)).data.get('linkedUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/onboarding_submissions/$(portalId)).data.get('uid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/onboarding_submissions/$(portalId)).data.get('ownerUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/onboarding_submissions/$(portalId)).data.get('portalId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/onboarding_submissions/$(portalId)).data.get('employeeId', '') == request.auth.uid
          )
        )
      );
    }

    function isSelfEmployee(userId, empData) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        empData.get('uid', '') == request.auth.uid ||
        empData.get('linkedUid', '') == request.auth.uid ||
        empData.get('portalId', '') == request.auth.uid
      );
    }

    function isSelfSubmission(subData) {
      return isAuthenticated() && (
        subData.get('uid', '') == request.auth.uid ||
        subData.get('linkedUid', '') == request.auth.uid ||
        subData.get('ownerUid', '') == request.auth.uid ||
        (request.auth.token.get('email', '') != '' && (
          subData.get('linkedGoogleEmail', '') == request.auth.token.email ||
          subData.get('email', '') == request.auth.token.email
        ))
      );
    }

    function hasActiveCorrectionToken(docData) {
      return docData.activeCorrectionToken != null &&
        exists(/databases/$(database)/documents/correction_requests/$(docData.activeCorrectionToken)) &&
        get(/databases/$(database)/documents/correction_requests/$(docData.activeCorrectionToken)).data.status == 'pending' &&
        get(/databases/$(database)/documents/correction_requests/$(docData.activeCorrectionToken)).data.expiresAt > request.time;
    }

    // ─── Settings / Metadata ────────────────────────────────────────────────
    // Form structure, login labels, and public stats are public (needed for onboarding + landing page)
    match /settings/{docId} {
      allow read: if docId in ['public_website', 'public_stats', 'sites', 'form_sections', 'portal_config'] || isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('MANAGE_SYSTEM') ||
        (docId == 'sites' && (hasPermission('SITES_MANAGE') || hasPermission('SITES_EDIT_INFO') || hasPermission('MANAGE_SITES'))) ||
        (docId == 'workflows' && hasPermission('MANAGE_WORKFLOWS')) ||
        (docId == 'form_sections' && (hasPermission('MANAGE_FORMS') || hasPermission('MANAGE_FORM_SECTIONS'))) ||
        (docId == 'portal_config' && (hasPermission('MANAGE_SYSTEM') || hasPermission('MANAGE_WORKFLOWS') || hasPermission('BGV_CONFIGURE_FIELDS'))) ||
        (docId == 'leave_policy' && (hasPermission('MANAGE_LEAVE_TYPES') || hasPermission('LEAVES_APPROVE'))) ||
        (docId == 'editable_fields' && (hasPermission('MANAGE_SYSTEM') || hasPermission('MANAGE_WORKFLOWS'))) ||
        (docId == 'gamification_rules' && (hasPermission('MANAGE_SYSTEM') || hasPermission('GAMIFICATION_MANAGE'))) ||
        (docId == 'legacy_claim_config' && (hasPermission('MANAGE_SYSTEM') || hasPermission('EMPLOYEES_IMPORT'))) ||
        (docId == 'public_stats' && (isSuperAdmin() || isAdmin() || hasPermission('MANAGE_SYSTEM')));
    }

    // ─── Contact Us Inquiries ────────────────────────────────────────────────
    match /contact_messages/{id} {
      // SEC-18: Enforce field-level validation and anti-spam constraints on public inquiries
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
                       request.resource.data.get('email', '') is string &&
                       (request.resource.data.get('email', '') == '' || (request.resource.data.get('email', '').size() >= 5 && request.resource.data.get('email', '').size() <= 120)) &&
                       request.resource.data.get('message', '') is string &&
                       request.resource.data.get('message', '').size() >= 5 && request.resource.data.get('message', '').size() <= 3000 &&
                       // Honeypot check: bot field must remain empty
                       request.resource.data.get('honeypot', '') == '';
      allow read, update, delete: if isAdmin();
    }

    // ─── Admin / Super-Admin Accounts ───────────────────────────────────────
    match /users/{userId} {
      allow get, list: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || (request.auth.token.get('email', '') != '' && request.auth.token.email == resource.data.get('email', '')));
      allow write: if isSuperAdmin();
    }

    // ─── Staff Accounts ─────────────────────────────────────────────────────
    match /staff_accounts/{userId} {
      allow get, list: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || (request.auth.token.get('email', '') != '' && request.auth.token.email == resource.data.get('email', '')));
      allow update: if isSuperAdmin() || (isAuthenticated() && (request.auth.uid == userId || (request.auth.token.get('email', '') != '' && request.auth.token.email == resource.data.get('email', ''))) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhotoURL', 'updatedAt', 'lastUpdated']));
      allow create, delete: if isSuperAdmin();
    }

    match /staff/{userId} {
      allow get, list: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || (request.auth.token.get('email', '') != '' && request.auth.token.email == resource.data.get('email', '')));
      allow update: if isSuperAdmin() || (isAuthenticated() && (request.auth.uid == userId || (request.auth.token.get('email', '') != '' && request.auth.token.email == resource.data.get('email', ''))) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhotoURL', 'updatedAt', 'lastUpdated']));
      allow create, delete: if isSuperAdmin();
    }

    // ─── Employee Records ────────────────────────────────────────────────────
    match /employees/{userId} {
      allow get: if resource == null ||
                    hasActiveCorrectionToken(resource.data) ||
                    isSelfEmployee(userId, resource.data) || 
                    (isAdmin() && (
                      canStaffViewSite(resource.data.get('currentSiteId', resource.data.get('siteId', ''))) ||
                      resource.data.get('assignedSiteIds', []).hasAny(request.auth.token.get('sitesManaged', []))
                    ));
      allow list: if isAdmin() || (isAuthenticated() && (
        resource.data.get('uid', '') == request.auth.uid || 
        resource.data.get('linkedUid', '') == request.auth.uid
      ));
      allow update: if canAdminManageEmployees() 
        || (isSelfEmployee(userId, resource.data) && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileStatus', 'lastUpdated', 'needsProfileCompletion', 'profilePhotoURL']) &&
              (request.resource.data.profileStatus == 'waiting_for_admin' || request.resource.data.profilePhotoURL != null)
            ) || (
              resource.data.get('needsProfileCompletion', false) == true &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileStatus', 'lastUpdated', 'needsProfileCompletion', 'profilePhotoURL', 'profileData', 'data'])
            )
        )) || (
            isAuthenticated() &&
            (resource.data.profileStatus == 'needs_completion' || resource.data.profileStatus == 'waiting_for_admin' || resource.data.get('needsProfileCompletion', false) == true) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) &&
            request.resource.data.uid == request.auth.uid &&
            (resource.data.get('linkedGoogleEmail', '') == request.auth.token.email || resource.data.get('email', '') == request.auth.token.email || resource.data.get('username', '') == request.auth.token.email)
        );
      allow create: if canAdminCreateEmployees();
      allow delete: if canAdminDeleteEmployees();
    }

    // ─── Onboarding Submissions ──────────────────────────────────────────────
    match /onboarding_submissions/{id} {
      allow get: if resource == null ||
                    hasActiveCorrectionToken(resource.data) ||
                    isSelfSubmission(resource.data) || 
                    (isAdmin() && canStaffViewSite(resource.data.get('siteId', '')));
      allow list: if isAdmin() || (isAuthenticated() && (
        resource.data.get('linkedUid', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('ownerUid', '') == request.auth.uid ||
        (request.auth.token.get('email', '') != '' && (
          resource.data.get('linkedGoogleEmail', '') == request.auth.token.email ||
          resource.data.get('email', '') == request.auth.token.email
        ))
      ));
      allow create: if isAuthenticated();
      allow update: if canAdminManageEmployees() 
        || (isAuthenticated() && (resource.id == request.auth.uid || resource.data.uid == request.auth.uid || resource.data.linkedUid == request.auth.uid));
      allow delete: if canAdminDeleteEmployees(); 
    }

    // ─── Draft Submissions ───────────────────────────────────────────────────
    match /draft_submissions/{id} {
      // SEC-05: Direct GET restricted to Admin or authenticated owner (public lookups routed through rate-limited getDraftSubmissionSecure)
      allow get: if isAdmin() || (isAuthenticated() && (
        resource.data.get('ownerUid', '') == request.auth.uid || 
        (resource.data.get('ownerEmail', '') != '' && resource.data.ownerEmail == request.auth.token.get('email', ''))
      ));
      // Listing or browsing drafts is strictly restricted to Admins or the draft owner (by UID or email)
      allow list: if isAdmin() || (isAuthenticated() && (resource.data.ownerUid == request.auth.uid || (resource.data.ownerEmail != null && resource.data.ownerEmail == request.auth.token.email)));
      // Anyone authenticated can create their draft by recovery code ID
      allow create: if isAuthenticated();
      // Updates allowed if admin, original owner, matching Google email, or matching active session
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        (resource.data.get('ownerEmail', '') != '' && resource.data.ownerEmail == request.auth.token.get('email', '')) ||
        (resource.data.get('isGoogleDraft', false) == false && (
          resource.data.get('activeSessionUid', '') == request.auth.uid ||
          resource.data.get('ownerUid', '') == request.auth.uid
        ))
      ));
      // Deletions allowed for admin, original owner, matching Google email, or matching active session
      allow delete: if isAdmin() || (isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        (resource.data.get('ownerEmail', '') != '' && resource.data.ownerEmail == request.auth.token.get('email', '')) ||
        (resource.data.get('isGoogleDraft', false) == false && (
          resource.data.get('activeSessionUid', '') == request.auth.uid ||
          resource.data.get('ownerUid', '') == request.auth.uid
        ))
      ));
    }

    // ─── Leave Requests ──────────────────────────────────────────────────────
    match /leave_requests/{id} {
      allow get: if (isAdmin() && (resource.data.get('siteId', '') == '' || canStaffViewSite(resource.data.get('siteId', '')))) || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow list: if isAdmin() || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow create: if isRegisteredUser() && (
        isAdmin() || (
          request.resource.data.status == 'Pending' &&
          request.resource.data.get('currentLevel', 1) == 1
        )
      );
      // Status, level, and approval history mutations are locked to Cloud Function (processRequestReviewServer)
      allow update: if isSuperAdmin() || (
        isRegisteredUser() &&
        resource.data.status == 'Pending' &&
        (resource.data.employeeId == request.auth.uid || resource.data.get('uid', '') == request.auth.uid || isOwnerOfPortalId(resource.data.employeeId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'currentLevel', 'approvedBy', 'rejectedBy', 'approvalHistory', 'adminComments'])
      );
      allow delete: if hasPermission('LEAVES_DELETE') || hasPermission('LEAVES_APPROVE') || isSuperAdmin();
    }

    // ─── Account Update Requests ─────────────────────────────────────────────
    match /account_updates/{id} {
      allow get: if (isAdmin() && (resource.data.get('siteId', '') == '' || canStaffViewSite(resource.data.get('siteId', '')))) || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow list: if isAdmin() || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow create: if isRegisteredUser() && (
        isAdmin() || (
          request.resource.data.status == 'Pending' &&
          request.resource.data.get('currentLevel', 1) == 1
        )
      );
      // Status, level, and approval history mutations are locked to Cloud Function (processRequestReviewServer)
      allow update: if isSuperAdmin() || (
        isRegisteredUser() &&
        resource.data.status == 'Pending' &&
        (resource.data.employeeId == request.auth.uid || resource.data.get('uid', '') == request.auth.uid || isOwnerOfPortalId(resource.data.employeeId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'currentLevel', 'approvedBy', 'rejectedBy', 'approvalHistory', 'adminComments'])
      );
      allow delete: if hasPermission('ACCOUNT_UPDATES_DELETE') || hasPermission('ACCOUNT_UPDATES_APPROVE') || isSuperAdmin();
    }

    // ─── Resignations ────────────────────────────────────────────────────────
    match /resignations/{id} {
      allow get: if (isAdmin() && (resource.data.get('siteId', '') == '' || canStaffViewSite(resource.data.get('siteId', '')))) || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow list: if isAdmin() || 
                    (isRegisteredUser() && (
                      resource.data.employeeId == request.auth.uid || 
                      resource.data.get('uid', '') == request.auth.uid ||
                      isOwnerOfPortalId(resource.data.employeeId)
                    ));
      allow create: if isRegisteredUser() && (
        isAdmin() || (
          request.resource.data.status == 'Pending' &&
          request.resource.data.get('currentLevel', 1) == 1
        )
      );
      // Status, level, and approval history mutations are locked to Cloud Function (processRequestReviewServer)
      allow update: if isSuperAdmin() || (
        isRegisteredUser() &&
        resource.data.status == 'Pending' &&
        (resource.data.employeeId == request.auth.uid || resource.data.get('uid', '') == request.auth.uid || isOwnerOfPortalId(resource.data.employeeId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'currentLevel', 'approvedBy', 'rejectedBy', 'approvalHistory', 'adminComments', 'isProcessed'])
      );
      allow delete: if hasPermission('RESIGNATIONS_DELETE') || hasPermission('RESIGNATIONS_APPROVE') || isSuperAdmin();
    }

    // ─── Disciplinary Actions ────────────────────────────────────────────────
    match /disciplinary_actions/{id} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && (
                       resource.data.employeeId == request.auth.uid || 
                       resource.data.get('targetUserId', '') == request.auth.uid ||
                       isOwnerOfPortalId(resource.data.employeeId) ||
                       (resource.data.get('portalId', '') != '' && isOwnerOfPortalId(resource.data.portalId))
                     ));
      allow create, update: if hasPermission('DISCIPLINE_MANAGE') || hasPermission('DISCIPLINE_CREATE') || hasPermission('DISCIPLINE_ISSUE') || isSuperAdmin();
      allow delete: if hasPermission('DISCIPLINE_MANAGE') || hasPermission('DISCIPLINE_DELETE') || isSuperAdmin();
    }

    // ─── Legacy Employee Imports ─────────────────────────────────────────────
    match /legacy_employee_imports/{id} {
      allow read, write: if isAdmin();
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        (request.auth.token.get('employeeId', '') != '' && resource.data.targetUserId == request.auth.token.employeeId) ||
        isOwnerOfPortalId(resource.data.targetUserId) ||
        resource.data.targetUserId == ('ROLE:' + getUserRoleId()) ||
        resource.data.targetUserId == 'ROLE:employee' ||
        resource.data.targetUserId == 'ROLE:role-security-guard' ||
        (isAdmin() && resource.data.targetUserId in ['all_admins', 'admin'])
      ));
      // SEC-09: Direct creation restricted to admins; non-admin notifications and role broadcasts route via sendNotificationServer
      allow create: if isAdmin();
      // SEC-09: Only direct personal notifications can be updated/deleted by users; broadcast (ROLE:) notifications are immutable for non-admins
      allow update, delete: if isAdmin() || (isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        (request.auth.token.get('employeeId', '') != '' && resource.data.targetUserId == request.auth.token.employeeId) ||
        isOwnerOfPortalId(resource.data.targetUserId)
      ));
    }

    // ─── Audit Logs (Immutable Ledger - Server-Enforced) ─────────────────────
    match /audit_logs/{id} {
      allow read: if hasPermission('VIEW_AUDIT_LOGS') || (isAuthenticated() && resource.data.actorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ─── Roles ───────────────────────────────────────────────────────────────
    match /roles/{roleId} {
      allow read: if isRegisteredUser();
      allow write: if isSuperAdmin();
    }

    // ─── Leave Balances ──────────────────────────────────────────────────────
    match /leave_balances/{id} {
      allow read: if isAdmin() || (isAuthenticated() && (
        id == request.auth.uid || 
        resource.data.employeeId == request.auth.uid || 
        isOwnerOfPortalId(id) || 
        isOwnerOfPortalId(resource.data.employeeId)
      ));
      allow write: if isAdmin();
    }

    // ─── Leave Policy ────────────────────────────────────────────────────────
    match /leave_policy/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── Portal Config ───────────────────────────────────────────────────────
    match /portal_config/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('MANAGE_SYSTEM') || hasPermission('BGV_CONFIGURE_FIELDS');
    }

    // ─── Editable Fields Config ──────────────────────────────────────────────
    match /editable_fields/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('MANAGE_SYSTEM');
    }

    // ─── Vacancies ───────────────────────────────────────────────────────────
    match /vacancies/{id} {
      allow read: if true; // Public — displayed on blog/careers page
      allow write: if isSuperAdmin() || hasPermission('VACANCIES_MANAGE');
    }

    // ─── Background Verification (BGV) Records ──────────────────────────────
    match /bgv_records/{id} {
      allow read: if isSuperAdmin() || 
                     hasPermission('BGV_VIEW') || 
                     hasPermission('BGV_VIEW_DOSSIER') || 
                     hasPermission('BGV_MANAGE') || 
                     hasPermission('BGV_DISPATCH_VENDOR') || 
                     hasPermission('BGV_UPLOAD_CERTIFICATE') || 
                     hasPermission('BGV_APPROVE_REJECT') || 
                     hasPermission('BGV_VENDOR') || 
                     (isAuthenticated() && (
                       resource.data.get('vendorId', '') == request.auth.uid ||
                       resource.data.get('vendorName', '') == request.auth.token.get('email', '')
                     ));
      allow create: if isSuperAdmin() || 
                       hasPermission('BGV_MANAGE') || 
                       hasPermission('BGV_DISPATCH_VENDOR');
      // SEC-06: Status changes and approvals strictly handled via Cloud Function (completeBgvReviewServer)
      allow update: if isSuperAdmin() || (
        (hasPermission('BGV_MANAGE') || hasPermission('BGV_DISPATCH_VENDOR') || hasPermission('BGV_UPLOAD_CERTIFICATE') || hasPermission('BGV_APPROVE_REJECT')) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedBy', 'approvedDate', 'rejectionReason'])
      ) || (
        isAuthenticated() && resource.data.get('vendorId', '') == request.auth.uid &&
        // SEC-06: Vendors can only update vendor notes & reports; forbidden from approving checks
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vendorNotes', 'vendorReportURL', 'vendorStatus', 'vendorCompletedAt', 
          'vendorDocuments', 'lastUpdated', 'updatedAt'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'result', 'internalStatus', 'approvedBy', 'approvedAt'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    // ─── Internal Rate-Limiting Collection ───────────────────────────────────
    // No client-side access at all — managed solely by Cloud Functions
    match /_auth_attempts/{id} {
      allow read, write: if false;
    }

    // ─── Data Correction Requests ───────────────────────────────────────────
    match /correction_requests/{id} {
      // Correction token holders need GET to load the form (token acts as credentials)
      allow get: if true;
      allow list: if isAdmin() || hasPermission('SUBMISSIONS_APPROVE');
      allow create, update, delete: if isAdmin() || hasPermission('SUBMISSIONS_APPROVE') || isSuperAdmin();
    }

    // ─── Referral Invites ───────────────────────────────────────────────────
    match /referral_invites/{id} {
      allow get: if true; // Publicly readable for validation/checks on form load
      allow create: if isSuperAdmin() || hasPermission('INVITES_CREATE');
      allow update: if (
        // Admin override (referral clicks, starts & joins are tracked exclusively server-side)
        isSuperAdmin() || hasPermission('INVITES_MANAGE')
      ) || (
        // Creator-specific checks
        isAuthenticated() && resource.data.createdBy == request.auth.uid && (
          // Creator wants to edit
          (request.resource.data.status == resource.data.status && hasPermission('INVITES_EDIT')) ||
          // Creator wants to reactivate
          (resource.data.status != 'Active' && request.resource.data.status == 'Active' && hasPermission('INVITES_REACTIVATE')) ||
          // Creator wants to revoke
          (request.resource.data.status == 'Revoked' && hasPermission('INVITES_DELETE'))
        )
      );
      allow delete: if isSuperAdmin();
      allow list: if isSuperAdmin() ||
                     hasPermission('INVITES_VIEW_ALL') ||
                     hasPermission('INVITES_MANAGE') ||
                     hasPermission('SITES_DELETE') ||
                     hasPermission('MANAGE_SITES') ||
                     (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // ─── Engagement, Attendance, and Complaints ──────────────────────────────
    match /user_engagement/{id} {
      allow read: if isAuthenticated() && (isOwnerOfPortalId(id) || isAdmin());
      // Allow initializing streak with initial points >= 0 and <= 50, referralCount strictly 0
      allow create: if isAuthenticated() && (isOwnerOfPortalId(id) || isAdmin()) && 
                    request.resource.data.get('points', 0) >= 0 &&
                    request.resource.data.get('points', 0) <= 50 && 
                    request.resource.data.get('referralCount', 0) == 0;
      // SEC-17: Prevent arbitrary point farming while permitting legitimate reward deductions & 1x/day streak increments
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (isOwnerOfPortalId(id) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCount']) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) ||
          (request.resource.data.get('points', 0) >= 0 && request.resource.data.get('points', 0) <= resource.data.get('points', 0)) ||
          (request.resource.data.get('lastVisitDate', '') is string &&
           request.resource.data.get('lastVisitDate', '') > resource.data.get('lastVisitDate', '') &&
           request.resource.data.get('points', 0) >= 0 &&
           request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 5)
        )
      );
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (isAuthenticated() && isOwnerOfPortalId(resource.data.userId));
      allow create: if isAuthenticated() && isOwnerOfPortalId(request.resource.data.userId);
      allow update: if isAdmin() || (isAuthenticated() && isOwnerOfPortalId(resource.data.userId) && isOwnerOfPortalId(request.resource.data.userId));
      allow delete: if isAdmin();
    }

    match /complaints/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isOwnerOfPortalId(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /reward_redemptions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && isOwnerOfPortalId(resource.data.userId));
      // SEC-17: Voucher generation and points verification strictly handled by Cloud Function (redeemRewardServer)
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ─── Blog Posts ──────────────────────────────────────────────────────────
    match /blog_posts/{id} {
      allow read: if resource.data.get('isPrivate', false) != true || isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('MANAGE_SYSTEM');
    }

    // ─── Central Recycle Bin (Soft Delete & Universal Undo Vault - Super Admin / Delegated HR) ───────────
    match /recycle_bin/{id} {
      allow read: if isSuperAdmin() || hasPermission('EMPLOYEES_TAB_RECYCLE_BIN');
      allow update, delete: if isSuperAdmin() ||
        (hasPermission('EMPLOYEES_TAB_RECYCLE_BIN') && !resource.data.get('itemType', '').matches('(?i)(STAFF|ROLE)'));
      // SEC-07: Non-superadmins cannot archive STAFF or ROLE documents to prevent Trojan privilege escalation
      allow create: if isSuperAdmin() || (isAdmin() && !request.resource.data.get('itemType', '').matches('(?i)(STAFF|ROLE)'));
    }

    // ─── Safety Quizzes ──────────────────────────────────────────────────────
    match /safety_quizzes/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasPermission('GAMIFICATION_MANAGE');
    }

    // ─── Gamification Logs (Immutable Ledger - Server-Enforced) ──────────────
    match /gamification_logs/{id} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isOwnerOfPortalId(resource.data.userId) || 
        isAdmin()
      );
      allow create, update, delete: if false;
    }
  }
}
